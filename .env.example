# Server
PORT=5100
NODE_ENV=development   # set to "production" when deployed

# MongoDB - local or Atlas connection string
MONGO_URL=mongodb://127.0.0.1:27017/obo

# JWT - use a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=1d

# Folder where uploaded images are saved. Leave empty to use the project's uploads/ folder.
# Example: UPLOAD_DIR=D:\OBO-files\uploads
UPLOAD_DIR=

# Set to 1 when running behind Cloudflare Tunnel or another proxy. Leave empty otherwise.
TRUST_PROXY=

# Set to true when served over HTTPS (e.g. through Cloudflare Tunnel)
COOKIE_SECURE=false

# First admin account, created by `npm run seed:admin`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_123
